# QuickSell backend configuration
#
# Copy to .env for local development:
#     cp .env.example .env
#
# On a real deployment, set these as real environment variables instead (Docker
# `-e` / compose `environment:` / Kubernetes Secret / Render & Fly dashboard /
# ECS task definition). Real env vars always take precedence over this file.
#
# Only MONGO_URL and JWT_SECRET are genuinely required in production. Everything
# else has a working default.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# "development" (default) boots with zero configuration and only warns about
# insecure settings. Set "production" on any real deployment and the app refuses
# to start with a missing or placeholder JWT_SECRET.
APP_ENV=development

# ---------------------------------------------------------------------------
# Database — any MongoDB
# ---------------------------------------------------------------------------
# Local mongod:      mongodb://localhost:27017
# Docker Compose:    mongodb://mongo:27017
# With auth:         mongodb://user:pass@host:27017/?authSource=admin
# MongoDB Atlas:     mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net
MONGO_URL=mongodb://localhost:27017
DB_NAME=quicksell

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# REQUIRED in production. Generate one with:
#     python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Changing it invalidates every issued login token.
JWT_SECRET=
JWT_EXP_DAYS=30

# The OTP code accepted while the admin OTP provider is set to "dev".
# Sign-in is dev-mode only until you wire up a real SMS provider, so treat this
# as a shared password and change it before exposing the app publicly.
DEV_OTP_CODE=123456

# ---------------------------------------------------------------------------
# SMS OTP delivery (Twilio)
# ---------------------------------------------------------------------------
# Set these, then switch the OTP provider to "twilio" from the in-app admin
# panel (gear icon on the seller Home tab; default PIN 0000, change it there
# too). The switch is rejected if these three aren't all set. Either
# TWILIO_MESSAGING_SERVICE_SID or TWILIO_FROM_NUMBER works -- set whichever
# one your Twilio setup uses, not both.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# How long a sent OTP code stays valid, how many wrong guesses are allowed
# before it's invalidated, and the minimum time between two sends to the same
# number (so a script can't spam a stranger's phone or run up your Twilio
# bill). Defaults are usually fine to leave as-is.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45

# ---------------------------------------------------------------------------
# Admin (app-owner) panel login
# ---------------------------------------------------------------------------
# Guards /admin/* -- not a seller's own app-open PIN, which is a separate,
# per-seller feature. After this many wrong PINs in a row, the panel locks out
# for ADMIN_LOGIN_LOCKOUT_SECONDS regardless of whether the next PIN offered
# is right. Defaults are usually fine to leave as-is.
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCKOUT_SECONDS=900

# ---------------------------------------------------------------------------
# Public URL
# ---------------------------------------------------------------------------
# The externally reachable base URL of this backend, no trailing slash.
# Used to build absolute image and upload URLs.
#   https://api.example.com        - API on its own domain
#   https://example.com            - API and web app on one domain
# Leave EMPTY to emit root-relative URLs, which is correct when the frontend is
# served from this same origin (see SERVE_FRONTEND).
BACKEND_PUBLIC_URL=

# Comma-separated allowed browser origins. "*" is the default and is acceptable
# for a public token-authenticated API, but prefer naming your real origins.
#   CORS_ORIGINS=https://shop.example.com,https://admin.example.com
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Serve the web app from this process (optional)
# ---------------------------------------------------------------------------
# Point at the output of `cd frontend && yarn build:web` and this backend serves
# the UI too, so a single container serves API + UI on one origin. Leave empty to
# host the frontend separately (Nginx, a CDN, Vercel, Netlify, S3+CloudFront...).
#   SERVE_FRONTEND=/app/frontend/dist
SERVE_FRONTEND=

# ---------------------------------------------------------------------------
# Image storage
# ---------------------------------------------------------------------------
# "local" - files on disk under MEDIA_ROOT. No cloud account needed. Mount a
#           persistent volume at MEDIA_ROOT or uploads die with the container.
# "s3"    - any S3-compatible object store.
# Leave empty to auto-detect: "s3" when S3_/B2_ settings are present, else "local".
STORAGE_BACKEND=local

# --- local backend ---
MEDIA_ROOT=./media
# Largest accepted upload, in bytes (local backend). Default 15 MiB.
MAX_UPLOAD_BYTES=15728640

# --- s3 backend: works with AWS S3, Backblaze B2, Cloudflare R2, MinIO,
#     DigitalOcean Spaces, Wasabi, Ceph RGW ---
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=quicksell
# S3_REGION=us-east-1
#
# S3_ENDPOINT_URL is REQUIRED for everything except AWS S3 itself:
#   Backblaze B2        https://s3.us-east-005.backblazeb2.com
#   Cloudflare R2       https://<account_id>.r2.cloudflarestorage.com
#   DigitalOcean Spaces https://nyc3.digitaloceanspaces.com
#   MinIO (self-hosted) http://minio:9000
# S3_ENDPOINT_URL=
#
# MinIO and some self-hosted gateways need path-style addressing.
# S3_FORCE_PATH_STYLE=false
#
# Legacy B2_* names (B2_KEY_ID, B2_APPLICATION_KEY, B2_BUCKET, B2_REGION,
# B2_ENDPOINT_URL) are still honoured, so an existing Backblaze deployment keeps
# working without any change to its environment.

# How long a presigned upload URL stays valid, in seconds.
UPLOAD_URL_TTL=600
