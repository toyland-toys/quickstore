# QuickSell frontend configuration
#
#     cp .env.example .env
#
# Expo inlines any EXPO_PUBLIC_* variable into the bundle at BUILD time, so these
# are baked in when you build and are visible to anyone using the app. Never put a
# secret in here.
#
# Every value below is optional. The app resolves the backend URL at runtime (see
# src/config.ts) and works with none of this set:
#   - on web, it defaults to the current origin, so serving the app from the same
#     host as the API needs no configuration at all;
#   - in native development, it defaults to the Expo dev server's host on port
#     8000, so a phone on the same network reaches your dev machine.

# Absolute URL of the backend, no trailing slash. Set this for:
#   - native builds you ship to a device or the app stores (they have no runtime
#     config file, so the URL must be compiled in);
#   - a web build served from a different origin than the API, if you would rather
#     bake the URL in than edit public/config.js after deploying.
# Leave it unset for a same-origin web deployment.
# EXPO_PUBLIC_BACKEND_URL=https://api.example.com

# Port the backend listens on during local native development, used to guess the
# dev machine's API URL. Defaults to 8000.
# EXPO_PUBLIC_DEV_BACKEND_PORT=8000
