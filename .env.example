# Configuration for `docker compose up`.
#
#     cp .env.example .env
#     # then set JWT_SECRET to the output of:
#     python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
#
# This file configures the Compose stack only. For running the backend directly
# (without Docker) see backend/.env.example, which documents every setting.

# REQUIRED. Compose refuses to start without it. Changing it logs everyone out.
JWT_SECRET=

# Database name inside the bundled MongoDB.
DB_NAME=quicksell

# Ports published on the host.
FRONTEND_PORT=8080
BACKEND_PORT=8000

# The OTP accepted while sign-in is in dev mode. Treat it as a shared password
# and change it before putting this on the public internet.
DEV_OTP_CODE=123456

# Absolute public URL of the API, no trailing slash. Leave EMPTY for the default
# setup, where the frontend proxies /api on whatever origin the browser is using
# — that works on localhost and behind a domain without changes.
# Set it only if the API is reachable at a different origin than the web app.
BACKEND_PUBLIC_URL=

# Allowed browser origins. Narrow this to your real domain in production.
CORS_ORIGINS=*

# --- Image storage -------------------------------------------------------
# "local" keeps uploads in the media-data Docker volume. Good for a single host.
# Switch to "s3" for any S3-compatible store, which is what you want as soon as
# you run more than one backend container or want a CDN in front of images.
STORAGE_BACKEND=local

# Only needed when STORAGE_BACKEND=s3.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=quicksell
# S3_REGION=us-east-005
# Required for anything that is not AWS S3 (Backblaze B2, R2, MinIO, Spaces):
# S3_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
# S3_FORCE_PATH_STYLE=false

# --- Frontend build ------------------------------------------------------
# Leave empty so one image works in every environment (the API is resolved at
# runtime). Set it to compile an absolute API URL into the bundle instead.
EXPO_PUBLIC_BACKEND_URL=
